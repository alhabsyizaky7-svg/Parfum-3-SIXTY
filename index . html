        <img src="84535.jpg" alt="3 SIXTY Logo" class="w-32 h-32 mx-auto rounded-full border-2 border-yellow-500 object-cover shadow-[0_0_15px_rgba(252,246,186,0.5)]">
        <h1 class="text-4xl font-bold mt-4 tracking-wider gold-gradient">3 SIXTY</h1>
        <p class="text-gray-400 text-sm tracking-widest uppercase mt-2">360° of Character</p>
    </header>

    <!-- Special Launching Banners -->
    <section class="max-w-4xl mx-auto px-4 mb-10">
        <div class="flex flex-col gap-4">
            <img src="84536.png" alt="Special Launching Promo" class="w-full rounded-lg shadow-lg">
            <img src="85531.jpg" alt="Promo Harga Spesial" class="w-full rounded-lg shadow-lg">
        </div>
        <div class="text-center mt-6 bg-red-900/30 border border-red-500/50 p-4 rounded-lg">
            <p class="text-xl font-bold text-yellow-500">PROMO SPESIAL!</p>
            <p class="text-lg">Harga Diskon: <span class="line-through text-gray-400 text-sm">Rp 45.000</span> <span class="font-bold text-2xl text-white">Rp 40.000</span></p>
            <p class="text-sm text-yellow-300 mt-1">Berlaku sampai dengan tanggal 15</p>
        </div>
    </section>

    <!-- Kategori Men -->
    <section class="max-w-4xl mx-auto px-4 mb-12">
        <div class="text-center mb-8">
            <h2 class="text-3xl font-playfair font-bold gold-gradient inline-block border-b-2 border-yellow-500 pb-2">MEN'S COLLECTION</h2>
        </div>
        
        <!-- Grid 2 Kolom untuk Produk -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <!-- AR-ONE -->
            <div class="product-card rounded-lg overflow-hidden flex flex-col">
                <img src="84532.png" alt="AR-ONE" class="w-full aspect-square object-cover">
                <div class="p-3 flex-grow flex flex-col justify-between">
                    <div>
                        <h3 class="text-lg font-bold text-yellow-500">AR-ONE</h3>
                        <p class="text-xs text-gray-300 mt-1">Fresh, maskulin, spicy, elegan</p>
                    </div>
                </div>
            </div>

            <!-- BLACK CODE -->
            <div class="product-card rounded-lg overflow-hidden flex flex-col">
                <img src="84533.png" alt="BLACK CODE" class="w-full aspect-square object-cover">
                <div class="p-3 flex-grow flex flex-col justify-between">
                    <div>
                        <h3 class="text-lg font-bold text-yellow-500">BLACK CODE</h3>
                        <p class="text-xs text-gray-300 mt-1">Fresh, spicy, warm, misterius</p>
                    </div>
                </div>
            </div>

            <!-- MEN'S CLUB -->
            <div class="product-card rounded-lg overflow-hidden flex flex-col">
                <img src="85009.jpg" alt="MEN'S CLUB" class="w-full aspect-square object-cover">
                <div class="p-3 flex-grow flex flex-col justify-between">
                    <div>
                        <h3 class="text-lg font-bold text-yellow-500 text-sm md:text-lg truncate">MEN'S CLUB</h3>
                        <p class="text-xs text-gray-300 mt-1">Fresh, clean, manly, sedikit manis</p>
                    </div>
                </div>
            </div>

            <!-- ROYAL MAN -->
            <div class="product-card rounded-lg overflow-hidden flex flex-col">
                <img src="85004.jpg" alt="ROYAL MAN" class="w-full aspect-square object-cover">
                <div class="p-3 flex-grow flex flex-col justify-between">
                    <div>
                        <h3 class="text-lg font-bold text-yellow-500 text-sm md:text-lg truncate">ROYAL MAN</h3>
                        <p class="text-xs text-gray-300 mt-1">Fresh, elegant, clean, woody</p>
                    </div>
                </div>
            </div>
            
            <!-- RS-ONE -->
            <div class="product-card rounded-lg overflow-hidden flex flex-col">
                <img src="85013.jpg" alt="RS-ONE" class="w-full aspect-square object-cover">
                <div class="p-3 flex-grow flex flex-col justify-between">
                    <div>
                        <h3 class="text-lg font-bold text-yellow-500">RS-ONE</h3>
                        <p class="text-xs text-gray-300 mt-1">Fruity, fresh, smoky, woody</p>
                    </div>
                </div>
            </div>

             <!-- SIGNATURE -->
             <div class="product-card rounded-lg overflow-hidden flex flex-col">
                <img src="85498.jpg" alt="SIGNATURE" class="w-full aspect-square object-cover">
                <div class="p-3 flex-grow flex flex-col justify-between">
                    <div>
                        <h3 class="text-lg font-bold text-yellow-500">SIGNATURE</h3>
                        <p class="text-xs text-gray-300 mt-1">Baccarat Rouge 540 x Creed Aventus</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Kategori Women -->
    <section class="max-w-4xl mx-auto px-4 mb-16">
        <div class="text-center mb-8">
            <h2 class="text-3xl font-playfair font-bold gold-gradient inline-block border-b-2 border-yellow-500 pb-2">WOMEN'S COLLECTION</h2>
        </div>
        
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4 justify-center">
            <!-- WHITE ORCHID -->
            <div class="product-card rounded-lg overflow-hidden flex flex-col">
                <img src="84537.png" alt="WHITE ORCHID" class="w-full aspect-square object-cover">
                <div class="p-3 flex-grow flex flex-col justify-between">
                    <div>
                        <h3 class="text-lg font-bold text-yellow-500 text-sm md:text-lg truncate">WHITE ORCHID</h3>
                        <p class="text-xs text-gray-300 mt-1">Floral, oriental, warm, sensual</p>
                    </div>
                </div>
            </div>

            <!-- LADY CHARM -->
            <div class="product-card rounded-lg overflow-hidden flex flex-col">
                <img src="84534.png" alt="LADY CHARM" class="w-full aspect-square object-cover">
                <div class="p-3 flex-grow flex flex-col justify-between">
                    <div>
                        <h3 class="text-lg font-bold text-yellow-500 text-sm md:text-lg truncate">LADY CHARM</h3>
                        <p class="text-xs text-gray-300 mt-1">Fresh, fruity, floral, playful</p>
                    </div>
                </div>
            </div>
            
            <!-- BELLA (Karena tidak ada foto, saya sembunyikan kotak abunya agar rapi) -->
            <!-- Jika nanti Anda punya fotonya, hapus tanda komentar ini dan ubah src-nya -->
            <!--
            <div class="product-card rounded-lg overflow-hidden flex flex-col">
                <img src="nama-foto-bella.jpg" alt="BELLA" class="w-full aspect-square object-cover">
                <div class="p-3 flex-grow flex flex-col justify-between">
                    <div>
                        <h3 class="text-lg font-bold text-yellow-500 text-center">BELLA</h3>
                        <p class="text-xs text-gray-300 mt-1 text-center">Floral, feminine, soft, elegant</p>
                    </div>
                </div>
            </div>
            -->
        </div>
    </section>

    <!-- Formulir Pemesanan -->
    <section class="max-w-md mx-auto px-4 mb-20" id="order-section">
        <div class="bg-[#111] p-6 rounded-xl border border-yellow-600/30 shadow-[0_0_20px_rgba(191,149,63,0.15)]">
            <h2 class="text-2xl font-playfair font-bold text-center mb-6 gold-gradient">Formulir Pesanan</h2>
            
            <form id="orderForm" class="space-y-4">
                <div>
                    <label class="block text-sm text-gray-300 mb-1">Nama Lengkap</label>
                    <input type="text" id="nama" required class="w-full bg-black border border-gray-700 rounded px-3 py-2 text-white focus:outline-none focus:border-yellow-500">
                </div>
                
                <div>
                    <label class="block text-sm text-gray-300 mb-1">Alamat Pengiriman</label>
                    <textarea id="alamat" required rows="3" class="w-full bg-black border border-gray-700 rounded px-3 py-2 text-white focus:outline-none focus:border-yellow-500"></textarea>
                </div>
                
                <div>
                    <label class="block text-sm text-gray-300 mb-1">Kategori</label>
                    <select id="kategori" required class="w-full bg-black border border-gray-700 rounded px-3 py-2 text-white focus:outline-none focus:border-yellow-500" onchange="updateAromaOptions()">
                        <option value="" disabled selected>-- Pilih Kategori --</option>
                        <option value="Men">Men's Collection</option>
                        <option value="Women">Women's Collection</option>
                    </select>
                </div>

                <div>
                    <label class="block text-sm text-gray-300 mb-1">Pilih Aroma</label>
                    <select id="aroma" required class="w-full bg-black border border-gray-700 rounded px-3 py-2 text-white focus:outline-none focus:border-yellow-500">
                        <option value="" disabled selected>-- Pilih Kategori Terlebih Dahulu --</option>
                    </select>
                </div>
                
                <div>
                    <label class="block text-sm text-gray-300 mb-1">Jumlah Botol</label>
                    <input type="number" id="jumlah" min="1" value="1" required class="w-full bg-black border border-gray-700 rounded px-3 py-2 text-white focus:outline-none focus:border-yellow-500">
                </div>

                <button type="submit" class="w-full bg-gold text-black font-bold py-3 rounded-lg mt-4 hover:opacity-90 transition shadow-lg flex items-center justify-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
                    </svg>
                    Pesan via WhatsApp
                </button>
            </form>
        </div>
    </section>

    <!-- Footer -->
    <footer class="text-center py-6 border-t border-gray-800 text-gray-500 text-sm mt-10">
        <p>&copy; 2026 3 SIXTY. All rights reserved.</p>
    </footer>

    <script>
        const aromaOptions = {
            "Men": [
                "AR-ONE (Fresh, maskulin, spicy)", 
                "RS-ONE (Fruity, fresh, smoky)", 
                "SIGNATURE (Baccarat Rouge 540 x Creed Aventus)",
                "MEN'S CLUB (Fresh, clean, manly)", 
                "BLACK CODE (Fresh, spicy, misterius)", 
                "ROYAL MAN (Fresh, elegant, woody)"
            ],
            "Women": [
                "BELLA (Floral, feminine, elegant)", 
                "LADY CHARM (Fresh, fruity, playful)", 
                "WHITE ORCHID (Floral, oriental, sensual)"
            ]
        };

        function updateAromaOptions() {
            const kategori = document.getElementById("kategori").value;
            const aromaSelect = document.getElementById("aroma");
            
            // Bersihkan opsi saat ini
            aromaSelect.innerHTML = "";
            
            if (kategori && aromaOptions[kategori]) {
                aromaOptions[kategori].forEach(aroma => {
                    const option = document.createElement("option");
                    option.value = aroma;
                    option.textContent = aroma;
                    aromaSelect.appendChild(option);
                });
            } else {
                const option = document.createElement("option");
                option.value = "";
                option.textContent = "-- Pilih Kategori Terlebih Dahulu --";
                option.disabled = true;
                option.selected = true;
                aromaSelect.appendChild(option);
            }
        }

        document.getElementById('orderForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const nama = document.getElementById('nama').value;
            const alamat = document.getElementById('alamat').value;
            const aroma = document.getElementById('aroma').value;
            const jumlah = document.getElementById('jumlah').value;
            
            // Hitung harga (promo Rp 40.000)
            const harga = 40000;
            const total = harga * jumlah;
            
            const textWa = `Halo 3 SIXTY, saya ingin memesan parfum:%0A%0ANama: ${nama}%0AAlamat: ${alamat}%0AVarian: ${aroma}%0AJumlah: ${jumlah} Botol%0ATotal Harga: Rp ${total.toLocaleString('id-ID')}%0A%0AMohon info pembayarannya. Terima kasih!`;
            
            // Nomor WhatsApp tujuan 
            const nomorWa = '62895353844848';
            
            window.open(`https://wa.me/${nomorWa}?text=${textWa}`, '_blank');
        });
    </script>
</body>
</html>
